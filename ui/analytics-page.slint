import { Colors } from "colors.slint";
import { FontSize } from "theme.slint";

export global AnalyticsApi {
    pure callback draw-pie-chart(width: length, height: length) -> image;
}

export component AnalyticsPage inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    // Rectangle {
    //     width: 100%;
    //     background: Colors.neutral25;
    // }

    Text {
        text: @tr("Spending chart");
        color: Colors.textHeading;
        font-size: FontSize.heading-sm;
    }

    Rectangle {
        width: 500px;
        height: 500px;
        background: white;
        border-radius: 24px;
        Image {
            width: 100%;
            height: 100%;
            source: AnalyticsApi.draw-pie-chart(self.width,self.height);
        }
    }
}
