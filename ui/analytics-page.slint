import { Colors } from "colors.slint";

// TODO: show info on hover
// TODO: maybe grid
component Bar {
    in property <string> day;
    width: 100%;

    HorizontalLayout {
        width: 100%;
        spacing: 8px;
        cross-axis-alignment: center;

        // Text {
        //     text: day;
        //     color: Colors.textMuted;
        // }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.accent;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            background: Colors.neutral50;
            border-radius: 4px;
        }
    }
}

export component AnalyticsPage inherits VerticalLayout {
    width: 100%;
    height: 100%;

    Rectangle {
        width: 50px;
        height: 50px;
        background: Colors.blue100;
    }

    VerticalLayout {
        width: 100%;
        spacing: 8px;
        Bar {
            day: @tr("Sun");
        }

        Bar {
            day: @tr("Mon");
        }

        Bar {
            day: @tr("Tue");
        }

        Bar {
            day: @tr("Wed");
        }

        Bar {
            day: @tr("Thu");
        }

        Bar {
            day: @tr("Fri");
        }

        Bar {
            day: @tr("Sat");
        }
    }
}
