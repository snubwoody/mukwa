import { Colors } from "colors.slint";
import { State, Transaction } from "globals.slint";
import { FontSize } from "theme.slint";
import { Settings } from "settings.slint";

export struct Analytic {}

export global Analytics {
    pure callback draw-pie-chart(width: length, height: length) -> image;
}

component Sidebar {
    width: 350px;
    VerticalLayout {
        alignment: start;
        HorizontalLayout {
            padding: 20px;
            alignment: space-between;
            Text {
                text: @tr("Categories");
                color: Colors.textBody;
                font-weight: FontWeight.medium;
            }

            Text {
                text: @tr("Total spent");
                color: Colors.textBody;
                font-weight: FontWeight.medium;
            }
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Colors.borderNeutral;
        }

        VerticalLayout {
            padding-bottom: 16px;
            padding-top: 16px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 16px;
            // TODO: use a list view/scroll view
            // FIXME: medium not working
            property <[int]> placeholder-list: [0, 0, 0, 0, 0, 0, 0];

            for i in placeholder-list: VerticalLayout {
                alignment: start;
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("Groceries");
                        color: Colors.textBody;
                    }

                    Text {
                        text: @tr("$100.00");
                        color: Colors.textBody;
                    }
                }

                Rectangle {
                    width: 50%;
                    height: 20px;
                    background: Colors.blue700;
                    border-radius: 4px;
                }
            }
        }
    }
}

export component AnalyticsPage inherits HorizontalLayout {
    //alignment: end;

    Rectangle {
        //width: 100%;
        horizontal-stretch: 1;
        background: Colors.neutral25;
        VerticalLayout {
            //width: 100%;
            alignment: start;
            padding: 24px;
            spacing: 24px;
            horizontal-stretch: 1;

            Text {
                text: @tr("Spending Chart");
                color: Colors.textHeading;
                font-size: FontSize.heading;
            }

            VerticalLayout {
                spacing: 20px;

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Total spent");
                        color: Colors.textMuted;
                        font-weight: FontWeight.medium;
                    }

                    Text {
                        text: State.format-money(State.total-spent-all(), Settings.currency-code);
                        color: Colors.textHeading;
                        font-size: FontSize.heading;
                        font-weight: FontWeight.medium;
                    }
                }

                Rectangle {
                    width: 500px;
                    height: 500px;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: Analytics.draw-pie-chart(self.width,self.height);
                    }
                }
            }
        }
    }

    Rectangle {
        width: 1px;
        height: 100%;
        background: Colors.borderNeutral;
    }

    Sidebar { }
}
