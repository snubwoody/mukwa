import {
    VerticalBox,
    LineEdit,
} from "std-widgets.slint";
import { Colors } from "colors.slint";
import { Date, CalendarState } from "widgets/calendar.slint";
import { Account, Transaction, State, Category, Budget } from "globals.slint";
import { Button, TextField, PrimaryButton, IconButton } from "widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

component BudgetItem {
    in property <Budget> budget;
    property <Category> category: State.get-category(budget.category-id);

    HorizontalLayout {
        Rectangle {
            width: 100px;
            property <bool> active: false;

            TouchArea {
                clicked => {
                    if (!active) {
                        active = true;
                    }
                }
            }

            if active: TextField {
                width: 100%;
                text: category.title;

                accepted => {
                    State.update-category(category.id, self.text);
                    active = false;
                }
            }

            if !active: Text {
                width: 100%;
                text: category.title;
                color: Colors.textBody;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 100px;
            property <bool> active: false;

            TouchArea {
                clicked => {
                    if (!active) {
                        active = true;
                    }
                }
            }

            if active: TextField {
                width: 100%;
                text: budget.amount;
                horizontal-alignment: end;

                accepted => {
                    State.edit-budget(budget.id, self.text);
                    active = false;
                }
            }

            if !active: Text {
                width: 100%;
                text: State.format-money(budget.amount);
                color: Colors.textBody;
                horizontal-alignment: end;
            }
        }

        Text {
            width: 100px;
            text: State.format-money(State.total-spent(budget.id));
            color: Colors.textBody;
            horizontal-alignment: end;
        }

        Text {
            width: 100px;
            text: State.format-money(State.left-to-spend(budget.id));
            color: Colors.textBody;
            horizontal-alignment: end;
        }
    }
}

export component SpendingPage inherits VerticalLayout {
    in-out property <Date> current-date: CalendarState.today();
    alignment: start;
    spacing: 12px;
    padding: 16px;

    HorizontalLayout {
        spacing: 4px;
        cross-axis-alignment: center;
        alignment: start;

        IconButton {
            icon: IconSet.ChevronLeft;
            theme: ghost;
            accessible-label: @tr("Previous month");
            clicked => {
                current-date = CalendarState.decrement-month(current-date);
            }
        }

        Text {
            font-size: 20px;
            color: Colors.textHeading;
            text: current-date.year + "-" + current-date.month;
        }

        IconButton {
            icon: IconSet.ChevronRight;
            theme: ghost;
            accessible-label: @tr("Next month");
            clicked => {
                current-date = CalendarState.increment-month(current-date);
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        button := PrimaryButton {
            text: @tr("New category");
            clicked => {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        width: 250px;
        x: button.x;
        y: button.y + button.height + 4px;
        height: layout.preferred-height;

        close-policy: close-on-click-outside;

        Rectangle {
            background: white;
            border-width: 1px;
            border-radius: 4px;
            border-color: Colors.neutral50;
        }

        layout := VerticalLayout {
            alignment: start;
            padding: 8px;
            spacing: 12px;

            text-field := TextField {
                placeholder-text: @tr("New category");
            }

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: start;

                PrimaryButton {
                    theme: ghost;
                    text: @tr("Cancel");
                    clicked => popup.close();
                }

                PrimaryButton {
                    text: @tr("Confirm");
                    clicked => {
                        State.create-category(text-field.text);
                        popup.close();
                    }
                }
            }
        }
    }

    VerticalLayout {
        alignment: start;
        spacing: 8px;

        HorizontalLayout {
            padding-bottom: 8px;
            padding-top: 8px;

            Text {
                text: @tr("Category");
                color: Colors.textBody;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                width: 100px;
                text: @tr("Assigned");
                horizontal-alignment: end;
                color: Colors.textBody;
            }

            Text {
                width: 100px;
                text: @tr("Spent");
                horizontal-alignment: end;
                color: Colors.textBody;
            }

            Text {
                width: 100px;
                text: @tr("Available");
                horizontal-alignment: end;
                color: Colors.textBody;
            }
        }

        for budget in State.budgets: BudgetItem {
            budget: budget;
        }
    }
}
