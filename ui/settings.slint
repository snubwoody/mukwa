import { Colors } from "colors.slint";
import { Api, State } from "globals.slint";
import { ComboBox, Button } from "widgets.slint";

export global Settings {
    callback set-currency-code(string);
    callback set-font-family(string);
    in-out property <string> currency-code;
    in-out property <string> font-family;
}

component Setting inherits HorizontalLayout {
    in property <string> text;
    in property <string> helper-text;
    alignment: space-between;
    cross-axis-alignment: center;

    VerticalLayout {
        alignment: start;
        spacing: 4px;
        Text {
            text: text;
            font-size: 13px;
            color: Colors.textBody;
        }

        Text {
            text: helper-text;
            font-size: 11px;
            color: Colors.textMuted;
        }
    }

    @children
}

component GeneralSettings inherits VerticalLayout {
    padding: 12px;
    spacing: 12px;
    alignment: start;
    Text {
        text: "General";
        font-size: 15px;
        color: Colors.textBody;
    }

    Setting {
        text: @tr("Currency");
        helper-text: @tr("The currency for all transactions");

        ComboBox {
            options: State.currency-options;
            changed(value) => {
                Settings.set-currency-code(value);
            }
        }
    }
}

component AppearanceSettings inherits VerticalLayout {
    padding: 12px;
    alignment: start;
    spacing: 12px;
    Text {
        text: "Appearance";
        font-size: 15px;
        color: Colors.textBody;
    }

    HorizontalLayout {
        alignment: space-between;
        cross-axis-alignment: center;

        VerticalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: @tr("Font family");
                font-size: 13px;
                color: Colors.textBody;
            }

            Text {
                text: @tr("Font family for the entire app");
                font-size: 11px;
                color: Colors.textMuted;
            }
        }

        ComboBox {
            options: State.font-options;
            changed(value) => {
                Settings.set-font-family(value);
            }
        }
    }
}

enum Section {
    appearance,
    general,
}

component SettingsButton inherits Button {
    in property <bool> selected: false;
    alignment: start;
    background: selected ? Colors.neutral50 : transparent;
    border-radius: 4px;
}

export component SettingsDialog inherits PopupWindow {
    x: Api.window-size().width * 0.5 - self.width * 0.5;
    y: Api.window-size().height * 0.5 - self.height * 0.5;
    width: Api.window-size().width * 0.80;
    height: Api.window-size().height * 0.85;
    close-policy: close-on-click-outside;
    property <Section> active-section: general;

    Rectangle {
        background: white;
        border-radius: 20px;
        border-color: Colors.neutral50;
        border-width: 1px;

        HorizontalLayout {
            padding: 2px;
            Rectangle {
                max-width: 250px;
                background: Colors.neutral25;
                border-top-left-radius: 20px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;

                    SettingsButton {
                        text: "General";
                        selected: active-section == general;
                        clicked => {
                            active-section = general;
                        }
                    }

                    SettingsButton {
                        text: "Appearance";
                        selected: active-section == appearance;
                        clicked => {
                            active-section = appearance;
                        }
                    }
                }
            }

            if active-section == general: GeneralSettings { }
            if active-section == appearance: AppearanceSettings { }
        }
    }
}
