import {
    StandardListView,
    VerticalBox,
    ListView,
    Palette,
} from "std-widgets.slint";
import { Colors } from "./colors.slint";
import { Account, Transaction, State } from "./globals.slint";
import { Sidebar } from "./sidebar.slint";
export { Account, Transaction, State } from "./globals.slint";
import { Button } from "./widgets.slint";

component TransactionTable inherits VerticalLayout {
    in property <[string]> columns;
    in property <[Transaction]> transactions;
    vertical-stretch: 0;

    Button {
        text: @tr("Add transaction");
        clicked => State.create_transaction();
    }

    VerticalLayout {
        vertical-stretch: 0;
        HorizontalLayout {
            vertical-stretch: 0;
            for column in columns: Text {
                text: column;
                color: Colors.textBody;
            }
        }

        for transaction in transactions: HorizontalLayout {
            vertical-stretch: 0;
            Text {
                text: transaction.date;
                color: Colors.textBody;
            }

            Text {
                text: State.get_account_name(transaction.account-id);
                color: Colors.textBody;
            }

            Text {
                text: "Category";
                color: Colors.textBody;
            }

            Text {
                text: "Amount";
                color: Colors.textBody;
            }
        }
    }
}

export component MainWindow inherits Window {
    preferred-width: 750px;
    preferred-height: 750px;
    background: white;
    title: "Finance app";

    HorizontalLayout {
        Sidebar {
            accounts: State.accounts;
        }

        TransactionTable {
            columns: [@tr("Date"), @tr("Account"), @tr("Category"), @tr("Amount")];
            transactions: State.transactions;
        }
    }
}
