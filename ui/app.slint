import {
    StandardListView,
    VerticalBox,
    ListView,
    Palette,
    LineEdit,
} from "std-widgets.slint";
import { Colors } from "./colors.slint";
import { Account, Transaction, State, Category } from "./globals.slint";
export { Account, Transaction, State, Category } from "./globals.slint";
import { Button, TextField } from "widgets.slint";
import { TransactionPage } from "./transaction.slint";
import { SpendingPage } from "spending-page.slint";
import { PrimaryButton } from "widgets/button.slint";
import { ComboBoxItem } from "widgets/combobox.slint";
export { Date, CalendarState } from "./widgets/calendar.slint";
import { Table } from "tableview.slint";
import { TransactionPage } from "transaction.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

enum Page {
    spending,
    transactions
}

component SidebarButton inherits Button {
    in property <bool> selected;
    alignment: start;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;

    background: selected ? Colors.neutral50 : transparent;
    border-radius: 4px;

    @children
}

component Sidebar {
    in-out property <[Account]> accounts;
    in property <Page> current-page;
    callback select-page(Page);
    width: 350px;

    accessible-role: navigation;

    background := Rectangle {
        background: Colors.neutral25;
    }

    HorizontalLayout {
        VerticalLayout {
            spacing: 16px;
            padding-right: 8px;
            padding-left: 8px;
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                SidebarButton {
                    text: @tr("Spending");
                    selected: current-page == Page.spending;
                    clicked => select-page(Page.spending);
                    IconDisplay {
                        icon: IconSet.Banknote;
                        size: 14px;
                        stroke-width: 2;
                        stroke: Colors.textBody;
                    }
                }

                VerticalLayout {
                    SidebarButton {
                        text: @tr("All accounts");
                        selected: current-page == Page.transactions;
                        clicked => select-page(Page.transactions);

                        IconDisplay {
                            icon: IconSet.PiggyBank;
                            size: 14px;
                            stroke-width: 1.5;
                            stroke: Colors.textBody;
                        }
                    }

                    Flickable {
                        max-height: 250px;
                        viewport-height: content.preferred-height;

                        content := VerticalLayout {
                            padding-left: 16px;
                            for account in accounts: HorizontalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    text: account.name;
                                    color: black;
                                }

                                Text {
                                    text: State.format-money(State.account-balance(account.id));
                                    color: Colors.textBody;
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 12px;
                padding-left: 4px;

                create-account-btn := PrimaryButton {
                    theme: neutral;
                    text: @tr("Create account");
                    clicked => popup.show();
                }

                popup := PopupWindow {
                    width: create-account-btn.width;
                    x: create-account-btn.x;
                    y: create-account-btn.y + create-account-btn.height + 4px;
                    height: layout.preferred-height;

                    close-policy: close-on-click-outside;

                    // FIXME: focus not working
                    forward-focus: focus-scope;
                    focus-scope := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return) {
                                State.create_account(text-field.text);
                                popup.close();
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                popup.close();
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // TODO: add box shadow xs with just a border color
                    Rectangle {
                        background: white;
                        border-width: 1px;
                        border-radius: 4px;
                        border-color: Colors.neutral50;
                    }

                    layout := VerticalLayout {
                        alignment: start;
                        padding: 8px;
                        spacing: 12px;

                        Text {
                            text: @tr("Create new account");
                            font-size: 13px;
                            font-weight: 500;
                            color: Colors.textHeading;
                        }

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: @tr("Account name");
                                color: Colors.textBody;
                            }

                            text-field := TextField {
                                placeholder-text: @tr("My account");
                            }
                        }

                        // TODO: create account header
                        // TODO: submit on enter
                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: start;

                            PrimaryButton {
                                theme: ghost;
                                text: @tr("Cancel");
                                clicked => popup.close();
                            }

                            PrimaryButton {
                                text: @tr("Create");
                                clicked => {
                                    State.create_account(text-field.text);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Colors.neutral100;
        }
    }
}

export component MainWindow inherits Window {
    property <Page> active-page: Page.transactions;
    preferred-width: 750px;
    preferred-height: 750px;
    background: white;
    title: "Mukwa";

    HorizontalLayout {
        Sidebar {
            accounts: State.accounts;
            current-page: active-page;
            select-page(page) => {
                active-page = page;
            }
        }

        if active-page == Page.spending: SpendingPage { }

        if active-page == Page.transactions: TransactionPage {
            columns: [@tr("Date"), @tr("Account"), @tr("Category"), @tr("Outflow"), @tr("Inflow")];
            transactions: State.transactions;
        }
    }
}
