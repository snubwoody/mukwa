import {
    StandardListView,
    VerticalBox,
    ListView,
    Palette,
    LineEdit,
} from "std-widgets.slint";
import { Colors } from "./colors.slint";
import { Account, Transaction, State, Category } from "./globals.slint";
export { Account, Transaction, State, Category } from "./globals.slint";
import { Button, TextField } from "./widgets.slint";
import { TransactionPage } from "./transaction.slint";
import { SpendingPage } from "spending-page.slint";
import { PrimaryButton } from "widgets/button.slint";
import { ComboBoxItem } from "widgets/combobox.slint";
export { Date, CalendarState } from "./widgets/calendar.slint";
import { Table } from "tableview.slint";
import { TransactionPage } from "transaction.slint";

enum Page {
    spending,
    transactions
}

component Sidebar inherits VerticalLayout {
    in-out property <[Account]> accounts;
    in property <Page> current-page;
    width: 350px;
    spacing: 8px;
    padding: 8px;
    alignment: start;
    callback select-page(Page);

    // TODO: add accessible-role: navigation
    Button {
        text: "Spending";
        alignment: start;
        text-color: current-page == Page.spending ? Colors.accent : Colors.textBody;
        clicked => select-page(Page.spending);
    }

    Button {
        text: "All accounts";
        alignment: start;
        text-color: current-page == Page.transactions ? Colors.accent : Colors.textBody;
        clicked => select-page(Page.transactions);
    }

    HorizontalLayout {
        alignment: space-between;
        Text {
            text: "Accounts";
            color: black;
            font-weight: 600;
        }

        Text {
            text: State.total_balance();
            color: black;
            font-weight: 600;
        }
    }

    VerticalLayout {
        Flickable {
            max-height: 250px;
            viewport-height: content.preferred-height;

            // TODO: use dialog for creating account
            // TODO: context menu with rename that opens a popup
            content := VerticalLayout {
                for account in accounts: HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: account.name;
                        color: black;
                    }

                    Text {
                        text: State.account-balance(account.id);
                        color: Colors.textBody;
                    }
                }
            }
        }
    }

    PrimaryButton {
        theme: neutral;
        text: @tr("Create account");
        clicked => State.create_account("New account");
    }
}

export component MainWindow inherits Window {
    property <Page> active-page: Page.transactions;
    preferred-width: 750px;
    preferred-height: 750px;
    background: white;
    title: "Mukwa";

    HorizontalLayout {
        Sidebar {
            accounts: State.accounts;
            current-page: active-page;
            select-page(page) => {
                active-page = page;
            }
        }

        if active-page == Page.spending: SpendingPage { }

        if active-page == Page.transactions: TransactionPage {
            columns: [@tr("Date"), @tr("Account"), @tr("Category"), @tr("Outflow"), @tr("Inflow")];
            transactions: State.transactions;
        }
    }
}
