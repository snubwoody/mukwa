import { Api, State } from "globals.slint";
import { Table, TableRow, TableCell } from "tableview.slint";
import { Colors } from "colors.slint";
import { TextSize } from "theme.slint";
import { ComboBox, ComboBoxItem } from "widgets.slint";

component Dropdown {
    in property <string> label;
    in property <[ComboBoxItem]> options;

    VerticalLayout {
        spacing: 4px;
        alignment: start;

        Text {
            text: label;
            color: Colors.textBody;
            font-size: TextSize.body-large;
        }

        ComboBox {
            options: options;
        }
    }
}

// TODO: header vs no header
// TODO: split amount into inflow and outflow
// TODO: merge with existing transactions
export component ImportCsvDialog inherits PopupWindow {
    // FIXME: absolute position not working, based on parent
    x: Api.window-size().width * 0.5 - self.width * 0.5;
    y: Api.window-size().height * 0.5 - self.height * 0.5;
    width: Api.window-size().width * 0.80;
    height: Api.window-size().height * 0.85;
    close-policy: close-on-click-outside;

    Rectangle {
        background: white;
        border-radius: 20px;
        border-color: Colors.neutral50;
        border-width: 1px;
    }

    VerticalLayout {
        padding: 24px;

        HorizontalLayout {
            spacing: 8px;

            Dropdown {
                label: @tr("Date");
                options: [{ value: "date", text: "Date" }];
            }

            Dropdown {
                label: @tr("Payee");
                options: [{ value: "date", text: "Date" }];
            }

            Dropdown {
                label: @tr("Note");
                options: [{ value: "date", text: "Date" }];
            }

            Dropdown {
                label: @tr("Category");
                options: [{ value: "date", text: "Date" }];
            }

            Dropdown {
                label: @tr("Amount");
                options: [{ value: "date", text: "Date" }];
            }
        }

        Table {
            width: 100%;
            property <int> length: 4;

            TableRow {
                TableCell {
                    width: parent.width / length;
                    Text {
                        text: "Date";
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: "Payee";
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: "Note";
                        color: Colors.textBody;
                    }
                }

                // TODO: allow split inflow and outflow columns
                    TableCell {
                    width: parent.width / length;
                    Text {
                        text: "Amount";
                        color: Colors.textBody;
                    }
                }
            }
        }
    }
}
