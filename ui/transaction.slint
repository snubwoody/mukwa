import {
    StandardListView,
    VerticalBox,
    ListView,
    Palette,
    LineEdit,
} from "std-widgets.slint";
import { Colors } from "colors.slint";
import {
    Account,
    Transaction,
    State,
    UpdateTransactionOpts,
} from "globals.slint";
import { Button, ComboBox, TextField, PrimaryButton } from "widgets.slint";
import { FocusBorder } from "widgets/focus-border.slint";
import { Calendar } from "widgets/calendar.slint";
import { Table, TableRow, TableCell } from "tableview.slint";

component TransactionRow inherits TableRow {
    // FIXME: combobox state not changing after updating
    in property <Transaction> transaction;
    in property <int> length;
    in property <int> index;
    out property <string> category-id: transaction.category-id;
    out property <string> account-id: transaction.account-id;
    out property <string> outflow: transaction.outflow;
    out property <string> inflow: transaction.inflow;
    out property <string> date: transaction.date;
    callback select-row(int);

    padding-left: 8px;
    padding-right: 8px;
    forward-focus: focus-scope;

    // TODO: submit on enter
    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space) {
                select-row(index);
                return accept;
            }
            if (event.text == Key.Escape) {
                select-row(-1);
                return accept;
            }
            return reject;
        }
    }

    // FIXME: context menu not working
    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Duplicate");
                activated => State.duplicate_transaction(transaction.id);
            }

            MenuItem {
                title: @tr("Delete");
                activated => State.delete_transaction(transaction.id);
            }
        }
    }

    date-cell := TableCell {
        width: parent.width / length;
        if !parent.is-editing: Text {
            text: transaction.date;
            color: Colors.textBody;
        }

        if parent.is-editing: touch-area := TouchArea {
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: start;
                text: date;
                color: Colors.textBody;
            }

            clicked => {
                calendar-popup.show();
            }
        }

        calendar-popup := PopupWindow {
            x: date-cell.x;
            y: date-cell.y;

            width: 250px;
            height: 250px;

            close-policy: close-on-click-outside;

            calendar := Calendar {
                changed(value) => {
                    date = value.year + "-" + value.month + "-" + value.day;
                    calendar-popup.close();
                }
            }
        }
    }

    TableCell {
        width: parent.width / length;
        if !parent.is-editing: Text {
            text: State.get_account_name(transaction.account-id);
            color: Colors.textBody;
        }

        if parent.is-editing: ComboBox {
            options: State.account-options;
            changed(value) => {
                account-id = value;
            }
        }
    }

    TableCell {
        width: parent.width / length;
        if !parent.is-editing: Text {
            text: State.get-category(transaction.category-id).title;
            color: Colors.textBody;
        }

        if parent.is-editing: ComboBox {
            options: State.category-options;
            changed(value) => {
                category-id = value;
            }
        }
    }

    TableCell {
        width: parent.width / length;
        if !parent.is-editing: Text {
            text: transaction.outflow;
            color: Colors.textBody;
        }

        if parent.is-editing: TextField {
            text: outflow;
            input-type: decimal;
            edited => {
                outflow = self.text;
                inflow = "";
                // FIXME
                //inflow-input.text = "";
            }
        }
    }

    TableCell {
        width: parent.width / length;
        if !parent.is-editing: Text {
            text: transaction.inflow;
            color: Colors.textBody;
        }

        if parent.is-editing: TextField {
            text: inflow;
            input-type: decimal;
            edited => {
                inflow = self.text;
                outflow = "";
                // FIXME
                //inflow-input.text = "";
            }
        }
    }
}

export component TransactionPage inherits VerticalLayout {
    in property <[string]> columns;
    in property <[Transaction]> transactions;
    property <int> active-row: -1;

    function select-row(index: int) {
        active-row = index;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        Text {
            text: @tr("All accounts");
            font-size: 1.5rem;
            font-weight: 500;
            color: Colors.textHeading;
        }

        Text {
            text: State.total_balance();
            font-size: 1.25rem;
            color: Colors.textHeading;
        }
    }

    HorizontalLayout {
        alignment: end;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;

        PrimaryButton {
            text: @tr("Add transaction");
            clicked => State.create_transaction();
        }
    }

    // TODO: reset values after editing
    Table {
        width: 100%;
        property <int> length: 5;

        TableRow {
            padding-left: 8px;
            padding-right: 8px;
            for column in columns: TableCell {
                width: parent.width / length;
                Text {
                    text: column;
                    color: Colors.textBody;
                }
            }
        }

        for transaction[index] in transactions: TransactionRow {
            is-editing: active-row == index;
            index: index;
            transaction: transaction;
            length: length;

            select-row(value) => {
                select-row(value);
            }
            clicked => {
                select-row(index);
            }
            cancelled => {
                select-row(-1);
            }
            confirmed => {
                State.update-transaction(transaction.id, self.account-id,self.category-id, self.outflow,self.inflow,self.date);
                select-row(-1);
            }
        }
    }
}
