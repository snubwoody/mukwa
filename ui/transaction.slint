import {
    StandardListView,
    VerticalBox,
    ListView,
    Palette,
    LineEdit,
} from "std-widgets.slint";
import { Colors } from "./colors.slint";
import { Account, Transaction, State } from "./globals.slint";
import { Sidebar } from "./sidebar.slint";
export { Account, Transaction, State } from "./globals.slint";
import { Button, ComboBox } from "./widgets.slint";
import { FocusBorder } from "widgets/focus-border.slint";

component EditingRow inherits VerticalLayout {
    in property <Transaction> transaction;
    out property <string> selected-account-id: transaction.account-id;
    out property <string> selected-amount: transaction.amount;
    callback cancel();
    callback confirm();

    spacing: 8px;

    HorizontalLayout {
        vertical-stretch: 0;
        cross-axis-alignment: center;

        Text {
            text: transaction.date;
            color: Colors.textBody;
        }

        ComboBox {
            options: State.account-options;
            changed(value) => {
                selected-account-id = value;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            Text {
                text: State.get_account_name(transaction.category-id);
                color: Colors.textBody;
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: Colors.blue500;
            clip: true;
            width: 250px;
            height: 36px;
            border-radius: 4px;
            background: white;
            money-input := TextInput {
                text: transaction.amount;
                color: Colors.textBody;
                input-type: decimal;
                edited => {
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == Key.Return) {
                        selected-amount = money-input.text;
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: "Cancel";
            clicked => cancel();
        }

        Button {
            text: "Confirm";
            clicked => confirm();
        }
    }
}


// TODO: add focus scope, and make sure it continues from the current index
export component TransactionTable inherits VerticalLayout {
    in property <[string]> columns;
    in property <[Transaction]> transactions;
    property <int> active-row: -1;

    HorizontalLayout {
        alignment: end;

        Button {
            text: @tr("Add transaction");
            clicked => State.create_transaction();
        }
    }

    VerticalLayout {
        HorizontalLayout {
            for column in columns: Rectangle {
                Text {
                    width: 100%;
                    horizontal-alignment: start;
                    text: column;
                    color: Colors.textBody;
                }
            }
        }

        // TODO: focus when clicked
        // - Use accessibilty
        ListView {
            for transaction[i] in transactions: row := Rectangle {
                out property <bool> is-active: active-row == i;
                forward-focus: focus-scope;

                focus-scope := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.Space) {
                            active-row = i;
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            active-row = -1;
                            return accept;
                        }
                        return reject;
                    }
                    touch-area := TouchArea {
                        clicked => {
                            if (!is-active) {
                                active-row = i;
                            }
                        }
                    }
                }

                if focus-scope.has-focus: FocusBorder { }

                states [
                    active when is-active: {
                        background: Colors.blue50;
                        in {
                            animate background { duration: 50ms; }
                        }
                        out {
                            animate background { duration: 50ms; }
                        }
                    }
                    hovered when touch-area.has-hover: {
                        background: Colors.neutral25;
                        in {
                            animate background { duration: 50ms; }
                        }
                        out {
                            animate background { duration: 50ms; }
                        }
                    }
                ]

                HorizontalLayout {
                    vertical-stretch: 0;
                    visible: !is-active;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: 100%;
                            horizontal-alignment: start;
                            text: transaction.date;
                            color: Colors.textBody;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: 100%;
                            horizontal-alignment: start;
                            text: State.get_account_name(transaction.account-id);
                            color: Colors.textBody;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: 100%;
                            horizontal-alignment: start;
                            text: State.get_account_name(transaction.category-id);
                            color: Colors.textBody;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: 100%;
                            horizontal-alignment: start;
                            text: transaction.amount;
                            color: Colors.textBody;
                        }
                    }
                }

                edit-row := EditingRow {
                    visible: is-active;
                    transaction: transaction;
                    confirm => {
                        State.update_transaction(transaction.id, edit-row.selected-account-id, edit-row.selected-amount);
                        active-row = -1;
                    }
                    cancel => {
                        active-row = -1;
                    }
                }
            }
        }
    }
}
