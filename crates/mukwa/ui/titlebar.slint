import { Colors } from "colors.slint";
import { PrimaryButton } from "widgets.slint";
import { AutoUpdater } from "globals.slint";
import { ProgressBar } from "widgets/progress-bar.slint";

enum TitleBarButtonTheme {
    windows,
    windows-x,
    gnome,
}

export component TitleBarButton {
    in-out property <TitleBarButtonTheme> theme;
    in property <length> size: 40px;
    in property <length> border-radius: 0;

    width: size;
    height: 100%;
    accessible-enabled: true;
    accessible-role: button;

    callback clicked <=> touch-area.clicked;
    accessible-action-default() => {
        clicked()
    }

    function background-color(button-theme: TitleBarButtonTheme) -> color {
        if (button-theme == TitleBarButtonTheme.gnome) {
            return Colors.neutral100;
        }
        return transparent;
    }

    function hover-background-color(button-theme: TitleBarButtonTheme) -> color {
        if (button-theme == TitleBarButtonTheme.windows) {
            return Colors.neutral100;
        }
        if (button-theme == TitleBarButtonTheme.windows-x) {
            return #e81120;
        }
        if (button-theme == TitleBarButtonTheme.gnome) {
            return Colors.neutral200;
        }
        return transparent;
    }

    function icon-color(button-theme: TitleBarButtonTheme) -> color {
        return Colors.textBody;
    }

    background := Rectangle {
        background: touch-area.has-hover ? hover-background-color(theme) : background-color(theme);
        border-radius: border-radius;
        animate background { duration: 250ms; }
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        @children
    }

    touch-area := TouchArea {
        width: parent.width;
        height: parent.height;
    }
}

component UpdatePanel inherits HorizontalLayout {
    padding: 12px;
    spacing: 12px;
    alignment: end;
    height: 100%;

    if AutoUpdater.update-state == ready: PrimaryButton {
        text: @tr("Update & Restart");
        size: small;
        clicked => AutoUpdater.update-and-restart();
    }

    if AutoUpdater.update-state == downloading: Text {
        text: @tr("Downloading update");
        color: Colors.textBody;
    }

    if AutoUpdater.update-state == downloading: ProgressBar {
        width: 150px;
        thumb-color: Colors.accent;
        track-color: Colors.neutral100;
        progress: AutoUpdater.download-progress;
    }
}

export component TitleBar inherits WindowMoveArea {
    in property <bool> window-maximized;
    callback minimized();
    callback maximized();
    callback closed();
    height: 40px;

    Rectangle {
        background: Colors.neutral25;
    }

    TouchArea {
        double-clicked => {
            maximized();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        cross-axis-alignment: center;
        height: parent.height;
        Text {
            text: "Mukwa";
            font-weight: FontWeight.semi-bold;
            color: Colors.textHeading;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            height: 100%;

            UpdatePanel { }

            HorizontalLayout {
                spacing: 8px;
                padding-right: 8px;
                cross-axis-alignment: center;

                TitleBarButton {
                    width: 20px;
                    height: 20px;
                    theme: gnome;
                    border-radius: 999px;
                    accessible-label: @tr("Close window");
                    clicked => closed();
                    Image {
                        source: @image-url("assets/adwaita_window_close.svg");
                    }
                }
            }

            if Platform.os == windows: HorizontalLayout {
                height: 100%;
                TitleBarButton {
                    theme: windows;
                    accessible-label: @tr("Minimize window");
                    clicked => minimized();
                    Image {
                        source: @image-url("assets/fluent_subtract.svg");
                    }
                }

                TitleBarButton {
                    theme: windows;
                    clicked => maximized();
                    accessible-label: @tr("Maximize window");
                    Image {
                        width: 16px;
                        height: 16px;
                        source: root.window-maximized ? @image-url("assets/fluent_square_multiple.svg") : @image-url("assets/fluent_square.svg");
                    }
                }

                TitleBarButton {
                    theme: windows-x;
                    clicked => closed();
                    accessible-label: @tr("Close window");
                    Image {
                        source: @image-url("assets/fluent_dismiss.svg");
                    }
                }
            }
        }
    }
}
