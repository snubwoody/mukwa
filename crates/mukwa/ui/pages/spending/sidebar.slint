import { Colors } from "../../colors.slint";
import { Category, CategoryState, State, Budget, Api } from "../../globals.slint";
import { PrimaryButton, TextField, ProgressBar, IconButton } from "../../widgets.slint";
import { Settings } from "../../settings.slint";
import { Icons } from "../../icons.slint";

component BudgetTarget inherits Rectangle{
    in property <Category> category;
    property <Budget> budget: CategoryState.get-budget(category.id, CategoryState.current-month);
    // TODO: use enum
    property <bool> form-active: false;
    property <bool> is-editing: false;
    property <bool> has-target: CategoryState.has-budget-target(category.id);
    property <string> target: CategoryState.get-budget-target(category.id);
    background: white;
    border-radius: 12px;

    VerticalLayout {
        spacing: 8px;
        padding: 16px;
        alignment: start;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: @tr("Target");
                color: Colors.textBody;
                font-weight: FontWeight.semi-bold;
            }

            Text {
                text: State.format-money(target, Settings.currency-code);
                color: Colors.textBody;
                font-weight: FontWeight.semi-bold;
            }
        }

        if !has-target && !form-active: VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: @tr("A budget target is an estimate of how much you want to assign to a category each month.");
                wrap: word-wrap;
                color: Colors.textMuted;
            }

            PrimaryButton {
                text: @tr("Create target");
                clicked => {
                    form-active = true;
                }
            }
        }

        if has-target && !is-editing: VerticalLayout {
            alignment: start;
            spacing: 8px;
            property <int> difference: Api.money-to-int(target) - Api.money-to-int(budget.amount);

            Text {
                text: {
                    if difference <= 0 {
                        return "You've reached your target.";
                    }

                    return "Assigned " + State.format-money(budget.amount, Settings.currency-code) + " of " + State.format-money(target,Settings.currency-code);
                };
                color: Colors.textBody;
            }

            ProgressBar {
                progress: 0.5;
            }

            if difference > 0: Text {
                text: "Assign " + State.format-money(Api.int-to-money(difference), Settings.currency-code) + " more to reach your target.";
                color: Colors.textMuted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                PrimaryButton {
                    text: @tr("Assign");
                    theme: neutral;
                    clicked => {
                        CategoryState.edit-budget(budget.id, CategoryState.get-budget-target(category.id));
                    }
                }

                IconButton {
                    icon: Icons.pen;
                    theme: neutral;
                    clicked => {
                        is-editing = true;
                    }
                }
            }
        }

        if is-editing: VerticalLayout {
            spacing: 12px;
            function submit() {
                CategoryState.edit-budget-target(category.id, edit-text-field.text);
                target = CategoryState.get-budget-target(category.id);
                has-target = CategoryState.has-budget-target(category.id);
                is-editing = false;
            }

            edit-text-field := TextField {
                label: @tr("Every month I want to assign:");
                input-type: decimal;
                init => self.focus();
                accepted => submit();
            }

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                PrimaryButton {
                    text: @tr("Cancel");
                    theme: ghost;
                    clicked => {
                        is-editing = false;
                    }
                }

                PrimaryButton {
                    text: @tr("Save target");
                    clicked => submit();
                }

                PrimaryButton {
                    text: @tr("Delete target");
                    theme: danger;
                    clicked => {
                        CategoryState.delete-budget-target(category.id);
                        is-editing = false;
                        has-target = false;
                    }
                }
            }
        }

        if form-active: VerticalLayout {
            spacing: 8px;
            function submit() {
                CategoryState.create-budget-target(category.id, text-field.text);
                target = CategoryState.get-budget-target(category.id);
                has-target = CategoryState.has-budget-target(category.id);
                form-active = false;
            }

            text-field := TextField {
                label: @tr("Every month I want to assign:");
                input-type: decimal;
                init => self.focus();
                accepted => submit();
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                PrimaryButton {
                    text: @tr("Cancel");
                    theme: ghost;
                    clicked => {
                        form-active = false;
                    }
                }

                PrimaryButton {
                    text: @tr("Save target");
                    clicked => submit();
                }
            }
        }
    }
}

export component SpendingPageSideBar inherits Rectangle {
    in property <Category> category;
    background: Colors.surface0;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        alignment: start;

        Text {
            text: category.title;
            color: Colors.textBody;
            font-weight: FontWeight.semi-bold;
        }

        BudgetTarget {
            category: category;
        }
    }
}
