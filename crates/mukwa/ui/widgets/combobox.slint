import { Colors } from "../colors.slint";
import { FocusBorder } from "./focus-border.slint";
import { FontSize } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";

export struct ComboBoxItem {
    value: string,
    text: string,
}

// TODO: maybe add scrollbar size setting
// TODO: expand on hover
// TODO: height 100% then thumb (thumb should respond the number of items in the list with a min and max)
// TODO: Only enable when needed, or use scroll bar policy
component ScrollBar {
    in-out property <color> thumb-color: Colors.surface0;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;
    width: 8px;

    thumb := Rectangle {
        border-radius: 999px;
        background: thumb-color;
        height: {
            if root.maximum <= 0phx {
                return 0phx;
            }
            return max(min(32px,root.height),parent.height * (root.page-size / (root.maximum + root.page-size)));
        }
    }

    touch-area := TouchArea {
        moved => {
            debug(self.mouse-x,self.mouse-y);
        }
    }
}

component ScrollView {
    in-out property <length> content-height <=> flickable.content-height;
    preferred-width: 100%;
    preferred-height: 100%;

    flickable := Flickable {
        x: 0;
        y: 0;
        width: parent.width - scollbar.width;
        mouse-drag-pan-enabled: false;
        content-y <=> scollbar.value;
        // height: parent.height;
        @children
    }

    scollbar := ScrollBar {
        x: flickable.x + flickable.width;
        y: flickable.y;
        thumb-color: Colors.surface2;
        height: flickable.height;
        maximum: flickable.content-height - flickable.height;
        page-size: flickable.height;
    }
}

export component ComboBox {
    in-out property <string> label;
    in property <[ComboBoxItem]> options;
    out property <int> current-index: 0;
    in-out property <string> current-value: options[current-index].value;
    in property <bool> enabled: true;
    out property <int> selected-index: -1;

    callback changed(value: string);

    init => {
        current-index = options.find-index((option) => option.value == current-value);
    }

    public function open() {
        popup.show();
    }

    public function select(index: int) {
        selected-index = Math.min(Math.max(index,0),options.length - 1);
    }

    public function move-selection-up() {
        if current-index == selected-index - 1 {
            root.select(root.selected-index - 2);
        } else {
            root.select(root.selected-index - 1);
        }
    }

    public function move-selection-down() {
        if current-index == selected-index + 1 {
            root.select(root.selected-index + 2);
        } else {
            root.select(root.selected-index + 1);
        }
    }

    accessible-role: combobox;
    accessible-enabled: enabled;
    accessible-expanded: popup.is-open;
    accessible-expandable: true;
    accessible-value: current-value;
    forward-focus: focus-scope;

    focus-scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!self.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                popup.show();
                return accept;
            }
            return reject;
        }

        touch-area := TouchArea {
            enabled: root.enabled;
            clicked => {
                popup.show();
            }
        }
    }

    layout := FlexboxLayout {
        spacing: 8px;
        flex-direction: column;
        flex-wrap: no-wrap;
        if label != "": Text {
            text: label;
            color: Colors.textBody;
        }

        Rectangle {
            background: Colors.surface0;
            border-color: focus-scope.has-focus ? Colors.borderAccent : Colors.borderNeutral;
            border-width: 1px;
            border-radius: 8px;
            clip: true;

            FlexboxLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 8px;
                padding-right: 8px;
                flex-wrap: no-wrap;

                text := Text {
                    text: options[current-index].text;
                    color: Colors.textBody;
                    width: 100%;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                }
            }
        }
    }

    popup := PopupWindow {
        width: max(root.width,250px);
        y: layout.height + 8px;
        height: min(content.preferred-height,250px);
        close-policy: close-on-click-outside;
        forward-focus: popup-fs;

        popup-background := Rectangle {
            background: Colors.surface0;
            border-radius: 8px;
            border-width: 1px;
            border-color: Colors.borderNeutral;
        }

        popup-fs := FocusScope {
            key-pressed(event) => {
                if (!self.enabled) {
                    return reject;
                }
                if (event.text == Key.UpArrow) {
                    root.move-selection-up();
                    return accept;
                } else if (event.text == Key.DownArrow) {
                    root.move-selection-down();
                    return accept;
                } else if (event.text == Key.Return) {
                    changed(options[selected-index].value);
                    current-index = selected-index;
                    popup.close();
                    return accept;
                } else if (event.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                return reject;
            }
        }

        flickable := ScrollView {
            // width: parent.width;
            max-height: 250px;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: 12px;
                spacing: 8px;

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: @tr("Selected");
                        color: Colors.textMuted;
                        font-size: FontSize.caption;
                    }

                    Rectangle {
                        background: Colors.surface1;
                        border-radius: 4px;
                        height: 24px;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            padding: 8px;
                            spacing: 4px;

                            Icon {
                                icon: Icons.check;
                                size: 14px;
                                stroke-width: 2px;
                                stroke: Colors.textMuted;
                            }

                            Text {
                                text: options[current-index].text;
                                color: Colors.textBody;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: @tr("Change selection");
                        color: Colors.textMuted;
                        font-size: FontSize.caption;
                    }

                    VerticalLayout {
                        spacing: 4px;

                        for option[i] in options: Rectangle {
                            background: selected-index == i ? Colors.surface1 : Colors.surface0;
                            visible: current-index != i;
                            height: current-index == i ? 0px : 24px;
                            border-radius: 4px;
                            accessible-value: option.value;
                            accessible-id: option.value;
                            accessible-role: list-item;
                            accessible-action-default => {
                                root.select(i);
                                changed(options[selected-index].value);
                                current-index = selected-index;
                                popup.close();
                            }

                            states [
                                hovered when inner-touch-area.has-hover: {
                                    background: Colors.surface1;
                                    in {
                                        animate background { duration: 150ms; }
                                    }
                                }
                            ]

                            inner-touch-area := TouchArea {
                                clicked => {
                                    root.select(i);
                                    changed(options[selected-index].value);
                                    current-index = selected-index;
                                    popup.close();
                                }
                            }

                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding: 8px;

                                Text {
                                    text: option.text;
                                    color: Colors.textBody;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: white;
                width: 3px;
                height: 70%;
            }
        }
    }
}
