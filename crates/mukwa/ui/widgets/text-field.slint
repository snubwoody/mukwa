import { Colors } from "../colors.slint";

// TODO: handle cursor position and scrolling
export component TextField {
    in-out property <string> label;
    in property <string> placeholder-text;
    in-out property <string> text <=> text-input.text;
    in property <int> font-weight: FontWeight.normal;
    in-out property <InputType> input-type <=> text-input.input-type;
    in-out property <TextHorizontalAlignment> horizontal-alignment <=> text-input.horizontal-alignment;
    callback edited <=> text-input.edited;
    callback accepted <=> text-input.accepted;

    forward-focus: text-input;

    VerticalLayout {
        spacing: 8px;

        if label != "": Text {
            text: label;
            color: Colors.textBody;
        }

        Rectangle {
            background: white;
            border-color: text-input.has-focus ? Colors.accent : Colors.neutral50;
            border-width: 1px;
            border-radius: 4px;
            clip: true;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 8px;
                padding-right: 8px;

                text-input := TextInput {
                    font-weight: font-weight;
                    //accessible-placeholder-text: placeholder-text;
                    color: Colors.textBody;
                    text: placeholder-text;
                }
            }
        }
    }
}

export component InlineTextField {
    in property <string> text;
    in property <int> font-weight: FontWeight.normal;
    in property <string> field-text: text;
    property <bool> active: false;
    in property <InputType> input-type: InputType.text;
    callback accepted(string);

    Rectangle {
        TouchArea {
            clicked => {
                if (!active) {
                    active = true;
                }
            }
        }

        Text {
            visible: !active;
            text: text;
            font-weight: font-weight;
            color: Colors.textBody;
        }

        if active: TextField {
            text: field-text;
            input-type: input-type;
            font-weight: font-weight;
            init => {
                self.focus();
            }
            accepted => {
                accepted(self.text);
                active = false;
            }
        }
    }
}
