import { Colors } from "../colors.slint";

// TODO: maybe add scrollbar size setting
// TODO: expand on hover
// TODO: height 100% then thumb (thumb should respond the number of items in the list with a min and max)
// TODO: Only enable when needed, or use scroll bar policy
component ScrollBar {
    in-out property <color> thumb-color: Colors.surface0;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;
    width: 6px;

    thumb := Rectangle {
        border-radius: 999px;
        background: thumb-color;
        y: (root.height - thumb.height) * (-root.value / root.maximum);
        height: {
            if root.maximum <= 0phx {
                return 0phx;
            }
            return max(min(32px,root.height),parent.height * (root.page-size / (root.maximum + root.page-size)));
        }
    }

    touch-area := TouchArea {
        property <{ pressed-value: length, maximum: length, x: length, y: length }> saved-values;

        function update-saved-values() {
            self.saved-values = { pressed-value: -root.value, maximum: root.maximum, x: self.mouse-x, y: self.mouse-y };
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.update-saved-values();
            }
        }

        moved => {
            if (!self.enabled || !self.pressed) {
                return;
            }

            // Update reference points when the size of the viewport changes to
            // avoid 'jumping' during scrolling.
            if (self.saved-values.maximum != root.maximum) {
                self.update-saved-values();
            }
            root.value = -max(0px,min(root.maximum,self.saved-values.pressed-value + ((self.mouse-y - self.saved-values.y) * (root.maximum / (root.height - thumb.height)))));
        }

        scroll-event(event) => {
            if (event.delta-y != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-y));
                return accept;
            }
            reject
        }
    }
}

export component ScrollView {
    in-out property <length> content-height <=> flickable.content-height;
    preferred-width: 100%;
    preferred-height: 100%;

    flickable := Flickable {
        x: 0;
        y: 0;
        width: parent.width - scollbar.width;
        mouse-drag-pan-enabled: false;
        content-y <=> scollbar.value;
        // height: parent.height;
        @children
    }

    scollbar := ScrollBar {
        x: flickable.x + flickable.width;
        y: flickable.y;
        thumb-color: Colors.surface2;
        height: flickable.height;
        maximum: flickable.content-height - flickable.height;
        page-size: flickable.height;
    }
}
