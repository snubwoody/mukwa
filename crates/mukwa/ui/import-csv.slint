import { Colors } from "colors.slint";
import { Table, TableRow, TableCell } from "tableview.slint";
import { Api } from "globals.slint";
import { ComboBox, PrimaryButton } from "widgets.slint";

export struct ImportCsvRequest {
    records: [[string]],
    date-column-index: int,
    payee-column-index: int,
    category-column-index: int,
    note-column-index: int,
    outflow-column-index: int,
    inflow-column-index: int,
}

export global ImportCsvState {
    callback import-transactions();
    in-out property <[[string]]> records;
    in-out property <int> date-column-index;
    in-out property <int> payee-column-index;
    in-out property <int> category-column-index;
    in-out property <int> note-column-index;
    in-out property <int> outflow-column-index;
    in-out property <int> inflow-column-index;

    public function set-records(data: [[string]]) {
        records = data;
        date-column-index = min(0,ImportCsvState.records[0].length);
        payee-column-index = min(1,ImportCsvState.records[0].length);
        category-column-index = min(2,ImportCsvState.records[0].length);
        note-column-index = min(3,ImportCsvState.records[0].length);
        outflow-column-index = min(4,ImportCsvState.records[0].length);
        inflow-column-index = min(5,ImportCsvState.records[0].length);
    }
}

export component ImportCsvDialog inherits PopupWindow {
    // FIXME: absolute position not working, based on parent
    x: Api.window-size().width * 0.5 - self.width * 0.5;
    y: Api.window-size().height * 0.5 - self.height * 0.5;
    width: Api.window-size().width * 0.80;
    height: Api.window-size().height * 0.85;
    close-policy: close-on-click-outside;
    in property <data-transfer> data;
    property <[string]> columns: [
        @tr("Date"),
        @tr("Payee"),
        @tr("Category"),
        @tr("Note"),
        @tr("Outflow"),
        @tr("Inflow")
    ];

    init => {
        ImportCsvState.set-records(Api.read-csv(data));
    }

    Rectangle {
        background: white;
        border-color: Colors.borderNeutral;
        border-width: 1px;
        border-radius: 24px;
    }

    VerticalLayout {
        padding: 36px;

        // TODO: add none option
        HorizontalLayout {
            spacing: 16px;
            ComboBox {
                label: @tr("Date");
                current-value: ImportCsvState.records[0][ImportCsvState.date-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                     // TODO: use max here and test it?
                    ImportCsvState.date-column-index = self.current-index
                }
            }

            ComboBox {
                label: @tr("Payee");
                current-value: ImportCsvState.records[0][ImportCsvState.payee-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                    ImportCsvState.payee-column-index = self.current-index
                }
            }

            ComboBox {
                label: @tr("Category");
                current-value: ImportCsvState.records[0][ImportCsvState.category-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                    ImportCsvState.category-column-index = self.current-index
                }
            }

            ComboBox {
                label: @tr("Note");
                current-value: ImportCsvState.records[0][ImportCsvState.note-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                    ImportCsvState.note-column-index = self.current-index
                }
            }

            ComboBox {
                label: @tr("Outflow");
                current-value: ImportCsvState.records[0][ImportCsvState.outflow-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                    ImportCsvState.outflow-column-index = self.current-index
                }
            }

            ComboBox {
                label: @tr("Inflow");
                current-value: ImportCsvState.records[0][ImportCsvState.inflow-column-index];
                options: Api.csv-combobox-options(ImportCsvState.records);
                changed(value) => {
                    ImportCsvState.inflow-column-index = self.current-index
                }
            }
        }

        Table {
            property <int> length: 6;
            TableRow {
                for column in columns: TableCell {
                    width: parent.width / length;
                    Text {
                        text: column;
                        font-weight: FontWeight.semi-bold;
                        color: Colors.textBody;
                    }
                }
            }

            for record in ImportCsvState.records: TableRow {
                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.date-column-index];
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.payee-column-index];
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.category-column-index];
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.note-column-index];
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.outflow-column-index];
                        color: Colors.textBody;
                    }
                }

                TableCell {
                    width: parent.width / length;
                    Text {
                        text: record[ImportCsvState.inflow-column-index];
                        color: Colors.textBody;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;

            PrimaryButton {
                text: @tr("Import");
                clicked => {
                    ImportCsvState.import-transactions();
                }
            }
        }
    }
}
