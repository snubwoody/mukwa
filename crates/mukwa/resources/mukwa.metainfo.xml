    <releases>
        <release version="0.2.4" date="2026-10-10">
          <url type="details">https://github.com/snubwoody/mukwa/blob/main/CHANGELOG.md#024---2026-10-10</url>
          <description>
              <ul>
                  <li>Fixed an issue where combobox items were not being selected when clicked.</li>
              </ul>
          </description>
        </release>
        <release version="0.2.3" date="2026-10-10">
          <url type="details">https://github.com/snubwoody/mukwa/blob/main/CHANGELOG.md#023---2026-10-10</url>
          <description>
              <ul>
                  <li>Fixed an issue where budgets were not being created when changing months on the spending page.</li>
                  <li>Added checkboxes for selecting transactions.</li>
                  <li>Added button to delete selected transactions.</li>
              </ul>
          </description>
        </release>
        <release version="0.2.2" date="2026-10-04">
          <url type="details">https://github.com/snubwoody/mukwa/blob/main/CHANGELOG.md#022---2026-10-07</url>
          <description>
              <ul>
                  <li>Fixed incorrect left to budget calculation. Transfers to credit accounts are no longer subtracted from the left to budget amount.</li>
              </ul>
          </description>
        </release>
        <release version="0.2.1" date="2026-10-04">
          <url type="details">https://github.com/snubwoody/mukwa/blob/main/CHANGELOG.md#021---2026-10-04</url>
          <description>
              <ul>
                  <li>Added support for filtering categories on the analytics page.</li>
                  <li>Fixed the left to budget amount not updating when editing budgets.</li>
                  <li>Windows: Fixed the title bar not maximising when double-clicked.</li>
                  <li>Windows: Fixed minimise window button closing the window. </li>
              </ul>
          </description>
        </release>
        <release version="0.2.0" date="2026-09-21">
          <url type="details">https://github.com/snubwoody/mukwa/blob/main/CHANGELOG.md#020---2026-09-21</url>
          <description>
              <ul>
                  <li>Added support for importing transactions from CSV files.</li>
                  <li>Added a custom title bar on Windows.</li>
                  <li>Added a "Credit payments" auto category group. Every credit account will get its own category in the "Credit payments" group for tracking payments.</li>
                  <li>The spending page now displays how much money is available to assign.</li>
              </ul>
          </description>
        </release>
    </releases>
