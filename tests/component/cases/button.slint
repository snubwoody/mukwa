import { Button } from "widgets/button.slint";

export component TestCase inherits Rectangle {
    in-out property <bool> button-a-clicked: false;
    in-out property <bool> button-b-clicked: false;
    out property <bool> button-b-focused <=> button-b.has-focus;

    public function focus-button-b() {
        button-b.focus();
    }

    button-a := Button {
        clicked => {
            button-a-clicked = true;
        }
    }

    button-b := Button {
        clicked => {
            button-b-clicked = true;
        }
    }
}

